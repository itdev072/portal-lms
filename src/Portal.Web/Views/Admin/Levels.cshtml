@model List<Level>
@{
    ViewData["Title"] = "Levels";
}

<h1>CSK Levels</h1>
<a asp-controller="Admin" asp-action="CreateLevel" class="btn btn-primary mb-3">+ New level</a>

<table class="table">
    <thead><tr><th>#</th><th>Id</th><th>Name</th><th>Prerequisite</th><th>Hours</th><th></th></tr></thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Order</td>
                <td>@l.Id</td>
                <td>@l.NameEn</td>
                <td>@l.Prerequisite</td>
                <td>@l.EstimatedHours</td>
                <td>
                    <a asp-controller="Admin" asp-action="EditLevel" asp-route-id="@l.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <form asp-controller="Admin" asp-action="DeleteLevel" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@l.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this level?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
