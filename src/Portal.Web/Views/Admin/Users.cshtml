@model List<ApplicationUser>
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
<a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary mb-3">+ New user</a>

<table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.DisplayName</td>
                <td>@u.Email</td>
                <td>
                    <form asp-controller="Admin" asp-action="ChangeRole" method="post" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@u.Id" />
                        <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                            @foreach (var r in Enum.GetValues<UserRole>())
                            {
                                if (r == u.Role)
                                {
                                    <option value="@r" selected>@r</option>
                                }
                                else
                                {
                                    <option value="@r">@r</option>
                                }
                            }
                        </select>
                    </form>
                </td>
                <td>@(u.IsActive ? "Active" : "Deactivated")</td>
                <td>
                    <form asp-controller="Admin" asp-action="ToggleActive" method="post">
                        <input type="hidden" name="id" value="@u.Id" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(u.IsActive ? "Deactivate" : "Reactivate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
