@model ExamResultViewModel
@{
    ViewData["Title"] = "Exam result";
}

<h1>@Model.Exam.Title — Result</h1>
<div class="alert alert-info">
    <p class="fs-4 mb-0">Score: @Model.Attempt.Score / @Model.Attempt.MaxScore</p>
    <p class="text-muted mb-0">Submitted @Model.Attempt.SubmittedAt?.ToString("MMM d, yyyy h:mm tt")</p>
</div>
<a asp-controller="Student" asp-action="Exams" class="btn btn-primary">Back to exams</a>
