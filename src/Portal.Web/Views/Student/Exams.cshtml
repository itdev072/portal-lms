@model List<MidtermExam>
@{
    ViewData["Title"] = "Exams";
}

<h1>Exams</h1>
<ul class="list-group">
    @foreach (var exam in Model)
    {
        var open = DateTimeOffset.UtcNow >= exam.OpensAt && DateTimeOffset.UtcNow <= exam.ClosesAt;
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <strong>@exam.Title</strong>
                <div class="text-muted small">@exam.LevelId &middot; @exam.TimeLimitMinutes min &middot; closes @exam.ClosesAt.ToString("MMM d, yyyy")</div>
            </div>
            @if (open)
            {
                <a asp-controller="Student" asp-action="TakeExam" asp-route-id="@exam.Id" class="btn btn-primary btn-sm">Take exam</a>
            }
            else
            {
                <span class="badge bg-secondary">Not open</span>
            }
        </li>
    }
</ul>
