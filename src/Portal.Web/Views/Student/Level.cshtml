@model LevelDetailViewModel
@{
    ViewData["Title"] = Model.Level.NameEn;
}

<a asp-controller="Student" asp-action="Dashboard">&larr; Back to dashboard</a>
<h1>@Model.Level.Id — @Model.Level.NameEn</h1>
<p class="text-muted" dir="auto">@Model.Level.NameKm</p>
<p dir="auto">@Model.Level.DescriptionKm</p>

<h2 class="mt-4">Lessons</h2>
<ul class="list-group mb-4">
    @foreach (var lesson in Model.Lessons)
    {
        var done = Model.CompletedLessonIds.Contains(lesson.Id);
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <a asp-controller="Student" asp-action="Lesson" asp-route-id="@lesson.Id">@lesson.Order. @lesson.TitleEn</a>
            @if (done)
            {
                <span class="badge bg-success">Completed</span>
            }
            else
            {
                <span class="badge bg-secondary">@lesson.XpValue XP</span>
            }
        </li>
    }
</ul>

@if (Model.CaseStudyTask != null)
{
    <div class="card">
        <div class="card-header">Case Study: Student Management System</div>
        <div class="card-body" dir="auto">
            <p>@Model.CaseStudyTask.PromptKm</p>
            <span class="badge bg-info text-dark">@Model.CaseStudyTask.XpValue XP</span>
        </div>
    </div>
}
