@model TakeExamViewModel
@{
    ViewData["Title"] = Model.Exam.Title;
}

<h1>@Model.Exam.Title</h1>
<p class="text-muted">Time limit: @Model.Exam.TimeLimitMinutes minutes. Answer every question, then submit once.</p>

<form asp-controller="Student" asp-action="SubmitExam" method="post">
    <input type="hidden" name="examId" value="@Model.Exam.Id" />
    @for (var qi = 0; qi < Model.Questions.Count; qi++)
    {
        var q = Model.Questions[qi];
        <div class="card mb-3">
            <div class="card-body" dir="auto">
                <input type="hidden" name="Answers[@qi].QuestionId" value="@q.Id" />
                <p class="fw-bold">@q.Order. @q.QuestionKm <span class="text-muted small">(@q.Points pts)</span></p>
                @for (var i = 0; i < q.Options.Count; i++)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Answers[@qi].SelectedIndex" id="@(q.Id)-@i" value="@i" required />
                        <label class="form-check-label" for="@(q.Id)-@i">@q.Options[i]</label>
                    </div>
                }
            </div>
        </div>
    }
    <button type="submit" class="btn btn-primary">Submit exam</button>
</form>
