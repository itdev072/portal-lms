@model AddExamQuestionViewModel
@{
    ViewData["Title"] = "Add exam question";
}

<h1>Add question</h1>

<form asp-controller="Teacher" asp-action="AddExamQuestion" method="post">
    <input type="hidden" asp-for="ExamId" />
    <div class="mb-3">
        <label asp-for="QuestionKm" class="form-label"></label>
        <textarea asp-for="QuestionKm" class="form-control" rows="2" dir="auto"></textarea>
    </div>
    <div class="row mb-3">
        <div class="col-6 mb-2">
            <label asp-for="Option1" class="form-label"></label>
            <input asp-for="Option1" class="form-control" dir="auto" />
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Option2" class="form-label"></label>
            <input asp-for="Option2" class="form-control" dir="auto" />
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Option3" class="form-label">Option 3 (optional)</label>
            <input asp-for="Option3" class="form-control" dir="auto" />
        </div>
        <div class="col-6 mb-2">
            <label asp-for="Option4" class="form-label">Option 4 (optional)</label>
            <input asp-for="Option4" class="form-control" dir="auto" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label asp-for="CorrectIndex" class="form-label">Correct option (0-based index)</label>
            <input asp-for="CorrectIndex" class="form-control" type="number" min="0" max="3" />
        </div>
        <div class="col">
            <label asp-for="Points" class="form-label"></label>
            <input asp-for="Points" class="form-control" type="number" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Add question</button>
    <a asp-controller="Teacher" asp-action="ManageExam" asp-route-id="@Model.ExamId" class="btn btn-link">Done adding questions</a>
</form>
