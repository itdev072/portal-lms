@model CreateAttendanceSessionViewModel
@{
    ViewData["Title"] = "Take attendance";
}

<h1>Take attendance</h1>
<p class="text-muted">Opens a QR code students scan from their own phone. Their location is checked against the campus you pick, server-side — the QR code alone never marks anyone present.</p>

<form asp-controller="Teacher" asp-action="CreateAttendanceSession" method="post">
    <div class="mb-3">
        <label class="form-label">Class</label>
        <select name="ClassSectionId" class="form-select" required>
            @foreach (var s in Model.Sections)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Campus location</label>
        <select name="CampusLocationId" class="form-select" required>
            @foreach (var c in Model.Campuses)
            {
                <option value="@c.Id">@c.Name (radius @c.RadiusMeters m)</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Session valid for (minutes)</label>
        <input name="ValidMinutes" class="form-control" type="number" value="10" min="1" max="180" />
    </div>
    <button type="submit" class="btn btn-primary">Open attendance session</button>
</form>
