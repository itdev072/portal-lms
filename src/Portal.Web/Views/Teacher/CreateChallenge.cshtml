@model CodingChallenge
@{
    ViewData["Title"] = "New coding challenge";
}

<h1>New coding challenge</h1>
<p class="text-muted">Graded by matching the student's typed answer against the expected output (no sandboxed code execution in v1 — see the spec's Non-Goals). Good formats: "predict the output" or "fill in the blank".</p>

<form asp-controller="Teacher" asp-action="CreateChallenge" method="post">
    <input type="hidden" asp-for="LevelId" />
    <input type="hidden" asp-for="LessonId" />
    <div class="mb-3">
        <label asp-for="PromptKm" class="form-label"></label>
        <textarea asp-for="PromptKm" class="form-control" rows="2" dir="auto"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="StarterCode" class="form-label"></label>
        <textarea asp-for="StarterCode" class="form-control font-monospace" rows="5"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="SolutionCode" class="form-label"></label>
        <textarea asp-for="SolutionCode" class="form-control font-monospace" rows="5"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Expected output (what the student must type)</label>
        <input name="TestCases[0].ExpectedOutput" class="form-control font-monospace" />
        <input type="hidden" name="TestCases[0].Input" value="" />
    </div>
    <div class="row mb-3">
        <div class="col">
            <label asp-for="Difficulty" class="form-label"></label>
            <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<Difficulty>()"></select>
        </div>
        <div class="col">
            <label asp-for="XpValue" class="form-label"></label>
            <input asp-for="XpValue" class="form-control" type="number" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
