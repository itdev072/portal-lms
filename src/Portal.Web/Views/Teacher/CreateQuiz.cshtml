@model QuizItem
@{
    ViewData["Title"] = "New quiz item";
}

<h1>New quiz item</h1>

<form asp-controller="Teacher" asp-action="CreateQuiz" method="post">
    <input type="hidden" asp-for="LevelId" />
    <input type="hidden" asp-for="LessonId" />
    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<QuizType>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="QuestionKm" class="form-label"></label>
        <textarea asp-for="QuestionKm" class="form-control" rows="2" dir="auto"></textarea>
    </div>
    <div class="row mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-6 mb-2">
                <label class="form-label">Option @(i + 1)@(i >= 2 ? " (optional)" : "")</label>
                <input name="Options[@i]" class="form-control" dir="auto" />
            </div>
        }
    </div>
    <div class="mb-3">
        <label asp-for="CorrectIndex" class="form-label">Correct option (0-based index)</label>
        <input asp-for="CorrectIndex" class="form-control" type="number" min="0" max="3" />
    </div>
    <div class="mb-3">
        <label asp-for="ExplanationKm" class="form-label"></label>
        <textarea asp-for="ExplanationKm" class="form-control" rows="2" dir="auto"></textarea>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label asp-for="Difficulty" class="form-label"></label>
            <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<Difficulty>()"></select>
        </div>
        <div class="col">
            <label asp-for="XpValue" class="form-label"></label>
            <input asp-for="XpValue" class="form-control" type="number" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
