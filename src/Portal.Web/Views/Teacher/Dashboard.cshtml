@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<h1>Teacher Dashboard</h1>

<h2>My classes</h2>
<ul class="list-group mb-4">
    @foreach (var s in Model.Sections)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@s.Name <span class="text-muted">(@s.SemesterLabel)</span></span>
            <a asp-controller="Teacher" asp-action="Roster" asp-route-sectionId="@s.Id" class="btn btn-outline-primary btn-sm">View roster</a>
        </li>
    }
</ul>

<h2>Content by level</h2>
<div class="list-group mb-4">
    @foreach (var level in Model.Levels)
    {
        <a asp-controller="Teacher" asp-action="Content" asp-route-levelId="@level.Id" class="list-group-item list-group-item-action">
            @level.Id — @level.NameEn
        </a>
    }
</div>

<h2>Exams</h2>
<ul class="list-group mb-4">
    @foreach (var exam in Model.Exams)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@exam.Title @(exam.IsPublished ? "" : "(draft)")</span>
            <span>
                <a asp-controller="Teacher" asp-action="ManageExam" asp-route-id="@exam.Id" class="btn btn-outline-secondary btn-sm">Manage</a>
                <a asp-controller="Teacher" asp-action="ExamResults" asp-route-id="@exam.Id" class="btn btn-outline-primary btn-sm">Results</a>
            </span>
        </li>
    }
</ul>
<a asp-controller="Teacher" asp-action="CreateExam" class="btn btn-primary mb-4">+ New exam</a>

<h2>Recent attendance sessions</h2>
<ul class="list-group">
    @foreach (var s in Model.RecentSessions)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@s.CreatedAt.ToString("MMM d, h:mm tt") @(s.IsClosed ? "(closed)" : "")</span>
            <a asp-controller="Teacher" asp-action="AttendanceSession" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm">Open</a>
        </li>
    }
</ul>
<a asp-controller="Teacher" asp-action="CreateAttendanceSession" class="btn btn-primary mt-3">+ Take attendance</a>
