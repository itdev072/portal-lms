@model ExamManageViewModel
@{
    ViewData["Title"] = Model.Exam.Title;
}

<h1>@Model.Exam.Title @(Model.Exam.IsPublished ? "" : "(draft)")</h1>
<p class="text-muted">@Model.Exam.LevelId &middot; @Model.Exam.TimeLimitMinutes min &middot; @Model.Exam.OpensAt.ToString("MMM d") - @Model.Exam.ClosesAt.ToString("MMM d, yyyy")</p>

<h2>Questions (@Model.Questions.Count)</h2>
<ol class="list-group list-group-numbered mb-3">
    @foreach (var q in Model.Questions)
    {
        <li class="list-group-item" dir="auto">@q.QuestionKm <span class="text-muted small">(@q.Points pts, correct: @q.Options.ElementAtOrDefault(q.CorrectIndex))</span></li>
    }
</ol>

<a asp-controller="Teacher" asp-action="AddExamQuestion" asp-route-examId="@Model.Exam.Id" class="btn btn-outline-primary">+ Add question</a>

@if (!Model.Exam.IsPublished)
{
    <form asp-controller="Teacher" asp-action="PublishExam" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.Exam.Id" />
        <button type="submit" class="btn btn-primary" @(Model.Questions.Any() ? "" : "disabled")>Publish exam</button>
    </form>
}
<a asp-controller="Teacher" asp-action="ExamResults" asp-route-id="@Model.Exam.Id" class="btn btn-outline-secondary">View results</a>
