@model RosterViewModel
@{
    ViewData["Title"] = "Roster: " + Model.Section.Name;
}

<a asp-controller="Teacher" asp-action="Dashboard">&larr; Back to dashboard</a>
<h1>@Model.Section.Name</h1>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Total XP</th>
            <th>Levels completed</th>
            <th>Lessons completed</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Students)
        {
            <tr>
                <td>@row.Student.DisplayName <span class="text-muted">(@row.Student.Email)</span></td>
                <td>@row.TotalXp</td>
                <td>@row.LevelsCompleted</td>
                <td>@row.LessonsCompleted</td>
            </tr>
        }
    </tbody>
</table>
